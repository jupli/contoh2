# Midtrans — ambil dari Dashboard Midtrans > Settings > Configuration.
# Server Key JANGAN pernah dipakai di sisi klien.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Opsional
MIDTRANS_QRIS_ACQUIRER=shopeepay   # gopay | shopeepay | airpay shopee | nns
MIDTRANS_VA_BANK=bca               # bca | bni | bri | mandiri | permata

# Deploy:
#   vercel env add MIDTRANS_SERVER_KEY production
#   vercel env add MIDTRANS_IS_PRODUCTION production
# Uji lokal:
#   vercel env pull .env.local && vercel dev
